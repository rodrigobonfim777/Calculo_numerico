        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ==========================================\n",
        "# PARÂMETROS INICIAIS\n",
        "# ==========================================\n",
        "# Substitua pelo valor do raio r aplicável ao seu problema (ex: 50.0)\n",
        "r_base = 50.0\n",
        "\n",
        "print(\"=\"*50)\n",
