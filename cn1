        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ==========================================\n",
        "# 1. PARÂMETROS INICIAIS\n",
        "# ==========================================\n",
        "# ATENÇÃO: Substitua 'r_base' pelo valor do raio dado no seu problema.\n",
        "r_base = 50.0  # nm (exemplo)\n",
        "\n",
        "# Função da vazão. A equação 5 sugere que Q(r) é proporcional a r^4\n",
        "def Q(r):\n",
        "    return r**4\n",
        "\n",
        "# Vetor de variação do raio (Delta r): de 0.1 até 5.0 com passo 0.1\n",
        "dr = np.arange(0.1, 5.1, 0.1)\n",
        "\n",
        "# ==========================================\n",
        "# 2. CÁLCULOS\n",
        "# ==========================================\n",
        "# Raios alterados\n",
        "r_minus = r_base - dr\n",
        "r_plus  = r_base + dr\n",
        "\n",
        "# Vazões correspondentes\n",
        "Q_base  = Q(r_base)\n",
        "Q_minus = Q(r_minus)\n",
        "Q_plus  = Q(r_plus)\n",
        "\n",
        "# Erro Absoluto Máximo (Delta Q)\n",
        "# O erro máximo é a maior diferença em módulo em relação à vazão base\n",
        "erro_abs_minus = np.abs(Q_minus - Q_base)\n",
        "erro_abs_plus  = np.abs(Q_plus - Q_base)\n",
        "erro_abs_max   = np.maximum(erro_abs_minus, erro_abs_plus)\n",
        "\n",
        "# Erro Relativo Máximo e Erro Percentual Máximo\n",
        "erro_rel_max  = erro_abs_max / Q_base\n",
        "erro_perc_max = erro_rel_max * 100\n",
        "\n",
        "# Aproximação Linear (Equação 5 da imagem)\n",
        "erro_rel_linear  = 4 * (dr / r_base)\n",
        "erro_perc_linear = erro_rel_linear * 100\n",
        "\n",
        "# ==========================================\n",
        "# 3. CONSTRUÇÃO DOS GRÁFICOS\n",
        "# ==========================================\n",
        "# Configuração da figura com 4 subgráficos (2x2)\n",
        "plt.figure(figsize=(14, 10))\n",
        "plt.suptitle('D.1 Erro Geométrico - Análise de Vazão Q(r)', fontsize=16)\n",
        "\n",
        "# Gráfico 1: Q(r-), Q(r) e Q(r+)\n",
        "plt.subplot(2, 2, 1)\n",
        "plt.plot(dr, Q_minus, label='$Q(r_-)$', color='blue', linestyle='--')\n",
        "plt.axhline(y=Q_base, label='$Q(r)$ (Base)', color='black', linestyle='-')\n",
        "plt.plot(dr, Q_plus, label='$Q(r_+)$', color='red', linestyle='-.')\n",
        "plt.title('1. Vazões Calculadas')\n",
        "plt.xlabel('$\\Delta r$ (nm)')\n",
        "plt.ylabel('Vazão $Q$')\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "\n",
        "# Gráfico 2: Erro Absoluto Máximo\n",
        "plt.subplot(2, 2, 2)\n",
        "plt.plot(dr, erro_abs_max, color='purple', marker='o', markersize=4)\n",
        "plt.title('2. Erro Absoluto Máximo de $Q$')\n",
        "plt.xlabel('$\\Delta r$ (nm)')\n",
        "plt.ylabel('Erro Absoluto')\n",
        "plt.grid(True)\n",
        "\n",
        "# Gráfico 3: Erro Relativo Máximo vs Aproximação\n",
        "plt.subplot(2, 2, 3)\n",
        "plt.plot(dr, erro_rel_max, label='Erro Relativo Direto', color='green', marker='s', markersize=4)\n",
        "plt.plot(dr, erro_rel_linear, label='Aprox. Linear ($4 \\Delta r/r$)', color='orange', linestyle='--')\n",
        "plt.title('3. Erro Relativo Máximo de $Q$')\n",
        "plt.xlabel('$\\Delta r$ (nm)')\n",
        "plt.ylabel('Erro Relativo')\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "\n",
        "# Gráfico 4: Erro Percentual Máximo vs Aproximação\n",
        "plt.subplot(2, 2, 4)\n",
        "plt.plot(dr, erro_perc_max, label='Erro Percentual Direto', color='teal', marker='^', markersize=4)\n",
        "plt.plot(dr, erro_perc_linear, label='Aprox. Linear Percentual', color='orange', linestyle='--')\n",
        "plt.title('4. Erro Percentual Máximo de $Q$')\n",
        "plt.xlabel('$\\Delta r$ (nm)')\n",
        "plt.ylabel('Erro Percentual (%)')\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "\n",
        "# Ajuste de layout e exibição\n",
        "plt.tight_layout(rect=[0, 0, 1, 0.96])\n",
        "plt.show()"
