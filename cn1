        "# ==========================================\n",
        "# 1. ANÁLISE DE PRECISÃO (float32 vs float64)\n",
        "# ==========================================\n",
        "print(\"\\n--- 1. Comparação de Tipos de Ponto Flutuante ---\")\n",
        "\n",
        "# Convertendo o raio para as respectivas precisões\n",
        "r_32 = np.float32(r_base)\n",
        "r_64 = np.float64(r_base)\n",
        "\n",
        "# Calculando r^4 (e consequentemente Q, assumindo Q(r) = r^4)\n",
        "Q_32 = r_32 ** 4\n",
        "Q_64 = r_64 ** 4\n",
        "\n",
        "# Diferenças\n",
        "diff_abs = np.abs(Q_64 - Q_32)\n",
        "diff_rel = diff_abs / Q_64 if Q_64 != 0 else 0.0\n",
        "\n",
        "# Epsilon da máquina\n",
        "eps_32 = np.finfo(np.float32).eps\n",
        "eps_64 = np.finfo(np.float64).eps\n",
        "\n",
        "# Registros solicitados\n",
        "print(f\"Raio (r) float32 : {r_32}\")\n",
        "print(f\"Raio (r) float64 : {r_64}\")\n",
        "print(f\"Q (float32)      : {Q_32}\")\n",
        "print(f\"Q (float64)      : {Q_64}\")\n",
        "print(f\"Diferença Abs.   : {diff_abs}\")\n",
        "print(f\"Diferença Rel.   : {diff_rel}\")\n",
        "print(f\"Epsilon float32  : {eps_32:.4e}\")\n",
        "print(f\"Epsilon float64  : {eps_64:.4e}\")\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 2. PERDA DE SIGNIFICÂNCIA POR CANCELAMENTO\n",
        "# ==========================================\n",
        "print(\"\\n--- 2. Comparação de Expressões (Equação 6 vs 7) ---\")\n",
        "\n",
        "# Gerando valores progressivamente menores para a razão (Delta r / r)\n",
        "# logspace(-1, -17, 17) gera potências de 10 de 10^-1 até 10^-17\n",
        "dr_r_ratios = np.logspace(-1, -17, 17)\n",
        "dr_vals = dr_r_ratios * r_base\n",
        "\n",
        "# Listas para armazenar os resultados do gráfico\n",
        "delta1_vals = []\n",
        "delta2_vals = []\n",
        "\n",
        "print(f\"{'Razão Δr/r':<15} | {'Eq 6 (δ1)':<22} | {'Eq 7 (δ2)':<22}\")\n",
        "print(\"-\" * 65)\n",
        "\n",
        "for dr in dr_vals:\n",
        "    # Usando float64 para garantir que estamos testando o limite real da máquina\n",
        "    Q_r = np.float64(r_base)**4\n",
        "    Q_r_dr = np.float64(r_base + dr)**4\n",
        "\n",
        "    # Equação 6: [Q(r + Δr) - Q(r)] / Q(r)\n",
        "    # Sujeita a cancelamento catastrófico quando Δr é muito pequeno\n",
        "    delta1 = (Q_r_dr - Q_r) / Q_r\n",
        "\n",
        "    # Equação 7: (1 + Δr/r)^4 - 1\n",
        "    # Mais estável numericamente\n",
        "    termo_dr_r = np.float64(dr / r_base)\n",
        "    delta2 = (1.0 + termo_dr_r)**4 - 1.0\n",
        "\n",
        "    delta1_vals.append(delta1)\n",
        "    delta2_vals.append(delta2)\n",
        "\n",
        "    print(f\"{termo_dr_r:<15.1e} | {delta1:<22.15e} | {delta2:<22.15e}\")\n",
        "\n",
        "# ==========================================\n",
        "# 3. GERAÇÃO DO GRÁFICO\n",
        "# ==========================================\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "# Plotando ambas as equações em escala log-log\n",
        "plt.plot(dr_r_ratios, delta1_vals, label='$\\delta_1$ (Equação 6)', marker='o', color='red')\n",
        "plt.plot(dr_r_ratios, delta2_vals, label='$\\delta_2$ (Equação 7)', marker='x', linestyle='--', color='blue')\n",
        "\n",
        "# Configurações dos eixos (escala logarítmica e invertendo o eixo X)\n",
        "plt.xscale('log')\n",
        "plt.yscale('log')\n",
        "plt.gca().invert_xaxis()  # Valores menores ficam à direita para mostrar a queda\n",
        "\n",
        "plt.xlabel('Razão $\\Delta r / r$ (escala log)')\n",
        "plt.ylabel('Variação de Vazão $\\delta$ (escala log)')\n",
        "plt.title('Perda de Significância: Comparação entre Expressões')\n",
        "plt.legend()\n",
        "plt.grid(True, which=\"both\", ls=\"--\", alpha=0.6)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
